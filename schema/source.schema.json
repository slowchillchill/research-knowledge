{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Research source card metadata",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "kind": {
      "const": "source"
    },
    "id": {
      "type": "string",
      "pattern": "^S-[0-9]{6}$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "example": {
      "type": "boolean"
    },
    "source_type": {
      "enum": [
        "paper",
        "documentation",
        "dataset",
        "synthetic"
      ]
    },
    "authors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "original_url": {
      "type": "string",
      "pattern": "^https://[^/\\s]+"
    },
    "version_url": {
      "type": "string",
      "pattern": "^https://[^/\\s]+"
    },
    "version_note": {
      "type": "string",
      "minLength": 1
    },
    "accessed": {
      "type": "string",
      "format": "date"
    },
    "locators": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "required": [
    "schema_version",
    "kind",
    "id",
    "title",
    "version",
    "example",
    "source_type",
    "authors",
    "original_url",
    "version_url",
    "version_note",
    "accessed",
    "locators"
  ],
  "additionalProperties": false
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Research knowledge card metadata",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "kind": {
      "const": "knowledge"
    },
    "id": {
      "type": "string",
      "pattern": "^K-[0-9]{6}$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "example": {
      "type": "boolean"
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "lifecycle": {
      "enum": [
        "draft",
        "active",
        "superseded"
      ]
    },
    "evidence": {
      "type": "object",
      "properties": {
        "strength": {
          "enum": [
            "unassessed",
            "reported",
            "corroborated"
          ]
        },
        "replication": {
          "enum": [
            "not_attempted",
            "partial",
            "reproduced",
            "failed"
          ]
        },
        "note": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "strength",
        "replication",
        "note"
      ],
      "additionalProperties": false
    },
    "tags": {
      "type": "object",
      "properties": {
        "domains": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "methods": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "problems": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "domains",
        "methods",
        "problems"
      ],
      "additionalProperties": false
    },
    "aliases": {
      "type": "object",
      "properties": {
        "zh": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "en": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "zh",
        "en"
      ],
      "additionalProperties": false
    },
    "conditions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "review_after": {
      "type": "string",
      "format": "date"
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/citation"
      }
    },
    "relations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/relation"
      }
    }
  },
  "required": [
    "schema_version",
    "kind",
    "id",
    "title",
    "version",
    "example",
    "summary",
    "lifecycle",
    "evidence",
    "tags",
    "aliases",
    "conditions",
    "limitations",
    "review_after",
    "sources",
    "relations"
  ],
  "additionalProperties": false,
  "$defs": {
    "citation": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^S-[0-9]{6}$"
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "locator": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "id",
        "version",
        "locator",
        "role"
      ],
      "additionalProperties": false
    },
    "relation": {
      "type": "object",
      "properties": {
        "type": {
          "enum": [
            "depends_on",
            "supports",
            "limits",
            "conflicts_with",
            "supersedes",
            "transfer_to"
          ]
        },
        "target": {
          "type": "string",
          "pattern": "^K-[0-9]{6}$"
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "conditions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/citation"
          }
        },
        "verification": {
          "enum": [
            "unverified",
            "checked",
            "rejected"
          ]
        }
      },
      "required": [
        "type",
        "target",
        "reason",
        "conditions",
        "evidence",
        "verification"
      ],
      "additionalProperties": false
    }
  }
}
